{
  "state_vector_version": "1.0",
  "data_source": "ABCD v1.1",
  "static_variables": {
    "subflow": {
      "type": "categorical",
      "n_values": 55,
      "init": "sample from empirical subflow frequency in ABCD train split",
      "subflow_frequencies_top10": [
